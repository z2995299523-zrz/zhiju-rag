# Copy to .env for Docker Compose; set a long, unique admin password.
RAG_ADMIN_PASSWORD=
RAG_READER_PASSWORD=
# New workspace only: standard, research-finance, manufacturing, or a mounted JSON file.
RAG_INDUSTRY_PROFILE=standard
RAG_COOKIE_SECURE=0
# Set 1 for offline image/scanned-page reading; Compose needs --build after changing.
RAG_OCR_ENABLED=0

# Comma-separated exact hostnames (default port) or hostname:port.
RAG_ALLOWED_HOSTS=
RAG_ALLOW_PRIVATE_NETWORK=0
# RAG_CONNECTOR_FINANCE=...

# Configure each model independently. Blank = local retrieval and answers.
RAG_LLM_BASE_URL=
RAG_LLM_MODEL=
RAG_LLM_API_KEY=
RAG_EMBED_BASE_URL=
RAG_EMBED_MODEL=
RAG_EMBED_API_KEY=
